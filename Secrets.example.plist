<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Template for local API keys.

    1. Copy this file to `HiddenJams/Secrets.plist`
    2. Fill in your own keys

    The project uses Xcode synchronized folders, so a file inside HiddenJams/
    is included in the target automatically — no extra step.

    `Secrets.plist` is git-ignored. Never commit real keys.
-->
<plist version="1.0">
<dict>
	<!-- https://www.last.fm/api/account/create -->
	<key>LastFmAPIKey</key>
	<string></string>

	<!-- https://platform.openai.com/api-keys
	     NOTE: a key shipped inside the app can be extracted from the binary.
	     Use this for development only; proxy OpenAI through your own server
	     before shipping to the App Store. See SETUP.md. -->
	<key>OpenAIAPIKey</key>
	<string></string>
</dict>
</plist>
